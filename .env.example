# Copiar este archivo como .env.local (que ya está en .gitignore) y
# completar. Los DB_* son la conexión a la base PostgreSQL del servidor
# de planta: los usa solo el contenedor de PostgREST (servicio "api" de
# docker-compose.yml), nunca llegan al navegador. Levantar con:
#   docker compose --env-file .env.local --profile preview up -d --build
DB_HOST=192.168.10.143
DB_PORT=5432
DB_NAME=db_control_nectares
DB_USER=
DB_PASSWORD=
DB_SSL=false

# WebSocket del plc-bridge (ver /plc-bridge en la raíz del repo) — opcional,
# si no se define usa ws://192.168.10.143:4036 (el servidor de planta).
VITE_PLC_BRIDGE_WS_URL=
