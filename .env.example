# Copiar este archivo como .env.local (que ya está en .gitignore) y
# completar. Los DB_* son la conexión a la base PostgreSQL del servidor
# de planta: los usa solo el contenedor de PostgREST (servicio "api" de
# docker-compose.yml), nunca llegan al navegador. Levantar con:
#   docker compose --env-file .env.local --profile preview up -d --build
DB_HOST=192.168.10.143
DB_PORT=5432
DB_NAME=db_control_nectares
DB_USER=
DB_PASSWORD=
DB_SSL=false

# Correo de los avisos de Solicitudes de Inspección / Intervención (servicio
# "correo" de docker-compose.yml). Vacío = no se manda nada.
#   Gmail (para probar): SMTP_HOST=smtp.gmail.com, SMTP_PUERTO=465 y en
#     SMTP_CLAVE una "contraseña de aplicación" de la cuenta (no la normal).
#   Office 365 (@natulac.com): SMTP_HOST=smtp.office365.com, SMTP_PUERTO=587.
# CORREO_PARA: a quién le llega, separado por comas (ej. Mantenimiento).
# APP_URL: dirección de la app, para el enlace del correo (ej. http://192.168.10.143:4035).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_DE=
CORREO_PARA=
APP_URL=

# WebSocket del plc-bridge (ver /plc-bridge en la raíz del repo) — opcional,
# si no se define usa ws://192.168.10.143:4036 (el servidor de planta).
VITE_PLC_BRIDGE_WS_URL=
