# Copiar a .env (o pasar como variables de entorno en docker-compose.yml).
# Mientras no haya cableado/mapa de tags confirmado, dejar PLC_MODO=simulacion.

PLC_MODO=simulacion
PLC_BRIDGE_PUERTO=4036
PLC_BRIDGE_INTERVALO_MS=200

# --- Solo aplican con PLC_MODO=real ---

# PLC_1 (S7-1200 CPU 1212C, firmware V2.2), proyecto "Prom_Preparacion".
# Confirmado por automatizacion 2026-10-16. Red nueva por el router instalado
# para el PLC: PLC 192.168.0.10/24, gateway 192.168.0.1. OJO: esa subred
# (192.168.0.0/24) es distinta de la del servidor donde corre este bridge
# (192.168.10.0/24) -- falta confirmar que el servidor tenga ruta hacia
# 192.168.0.0/24 a traves de ese router antes de poner PLC_MODO=real alla.
# Sin valor por defecto a proposito: si falta, s7.js falla rapido en vez de
# intentar conectar a una IP al azar.
PLC_HOST=192.168.0.10

PLC_PUERTO=102
PLC_RACK=0
# Slot 1 para S7-1200/1500, slot 2 para S7-300/400 (ver README de nodes7).
PLC_SLOT=1
PLC_TIMEOUT_MS=5000
PLC_RECONEXION_MS=5000

# Direcciones S7 (formato nodes7, ej. "DB10,REAL4" o "DB10,X8.0").
# DB_MONITOREO = DB5 del programa. Acceso optimizado desactivado y valores
# reales (sin escalado), confirmado por automatizacion. PUT/GET viene
# habilitado por defecto en el S7-1200.
PLC_TAG_SETPOINT=DB5,DINT0
PLC_TAG_LITROS_ACTUALES=DB5,DINT4
PLC_TAG_TANQUE_ACTIVO=DB5,INT12
PLC_TAG_VALVULA_1=DB5,X14.0
PLC_TAG_VALVULA_2=DB5,X14.1
PLC_TAG_VALVULA_3=DB5,X14.2

# Actuador_Aux_Tank_1/2/3: valvula de recirculacion de producto o de CIP
# (no es la de entrada de agua). Cual de las dos depende de la condicion que
# tenga el tanque en la app -- se exponen tal cual en "auxiliares" y las
# interpreta el frontend, no el bridge.
PLC_TAG_AUX_1=DB5,X14.3
PLC_TAG_AUX_2=DB5,X14.4
PLC_TAG_AUX_3=DB5,X14.5

# Litros totales acumulados (no se resetea por tanque, a confirmar en campo).
PLC_TAG_TOTALES=DB5,DINT8

# Opcional: si el PLC llega a exponer un tag de caudal directo, poner la
# direccion aqui para que el bridge deje de derivarlo por delta de litros.
PLC_TAG_CAUDAL=
